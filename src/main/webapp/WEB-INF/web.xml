<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>GaraMan</display-name>

  <welcome-file-list>
    <welcome-file>login.jsp</welcome-file>
  </welcome-file-list>

  <servlet>
    <servlet-name>LoginServlet</servlet-name>
    <servlet-class>servlet.LoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>LogoutServlet</servlet-name>
    <servlet-class>servlet.LogoutServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LogoutServlet</servlet-name>
    <url-pattern>/logout</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AddAppointmentServlet</servlet-name>
    <servlet-class>servlet.AddAppointmentServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AddAppointmentServlet</servlet-name>
    <url-pattern>/addAppointment</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AppointmentInfoServlet</servlet-name>
    <servlet-class>servlet.AppointmentInfoServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AppointmentInfoServlet</servlet-name>
    <url-pattern>/appointmentInfo</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>RevenueStatServlet</servlet-name>
    <servlet-class>servlet.RevenueStatServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>RevenueStatServlet</servlet-name>
    <url-pattern>/revenueStat</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>RevenueDetailStatServlet</servlet-name>
    <servlet-class>servlet.RevenueDetailStatServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>RevenueDetailStatServlet</servlet-name>
    <url-pattern>/revenueDetailStat</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>InvoiceViewServlet</servlet-name>
    <servlet-class>servlet.InvoiceViewServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>InvoiceViewServlet</servlet-name>
    <url-pattern>/invoiceView</url-pattern>
  </servlet-mapping>

</web-app>
